--- /dev/null
+++ b/tests/test_workspace_blocked_roots_windows.py
@@ -0,0 +1,86 @@
+"""Regression tests for the Windows workspace blocked-roots check.
+
+POSIX root names are drive-relative on Windows: ``Path('/dev')`` is
+``\\dev`` and ``Path('/dev').resolve()`` becomes ``<current drive>:\\dev``.
+The historical POSIX blocklist therefore rejected any legitimate project
+stored under a top-level ``dev`` folder (for example
+``D:\\dev\\hermes-webui-portable-dev``) with
+"Path points to a system directory".
+
+The blocklist is now platform-specific: Windows blocks its native system
+directories (``%SystemRoot%``, ``%ProgramFiles%``, ``%ProgramData%`` ...)
+instead of the POSIX names, while POSIX-shaped remote-terminal paths are
+still rejected by the string-shape check.
+"""
+import os
+import sys
+from pathlib import Path
+
+import pytest
+
+from api.workspace import (
+    _is_blocked_system_path,
+    _is_blocked_workspace_path,
+    _workspace_blocked_roots,
+)
+
+pytestmark = pytest.mark.skipif(
+    sys.platform != 'win32',
+    reason="Windows-specific drive semantics",
+)
+
+
+def _current_drive_root() -> Path:
+    return Path(Path.cwd().anchor)
+
+
+class TestPosixNamesAreNotDriveRoots:
+    """``/dev`` must not be reinterpreted as ``<current drive>:\\dev``."""
+
+    @pytest.mark.parametrize(
+        "name",
+        ["dev", "etc", "usr", "var", "bin", "sbin", "boot", "proc", "sys", "lib", "lib64"],
+    )
+    def test_project_under_posix_named_top_level_dir_allowed(self, name):
+        candidate = _current_drive_root() / name / "my-project"
+        assert not _is_blocked_system_path(candidate)
+        assert not _is_blocked_workspace_path(candidate, str(candidate))
+
+    def test_dev_project_regression(self):
+        candidate = _current_drive_root() / "dev" / "hermes-webui-portable-dev"
+        assert not _is_blocked_workspace_path(candidate, str(candidate))
+
+    def test_blocked_roots_contain_no_resolved_posix_roots(self):
+        roots = _workspace_blocked_roots()
+        for posix_root in ("/dev", "/etc", "/usr", "/var", "/bin", "/lib", "/System", "/Library"):
+            assert Path(posix_root) not in roots
+            assert Path(posix_root).resolve() not in roots
+
+
+class TestNativeWindowsSystemDirsBlocked:
+    @pytest.mark.parametrize("env_name", ["SystemRoot", "ProgramFiles", "ProgramData"])
+    def test_env_system_dir_blocked(self, env_name):
+        value = os.environ.get(env_name)
+        if not value:
+            pytest.skip(f"{env_name} is not set")
+        root = Path(value)
+        assert _is_blocked_system_path(root)
+        assert _is_blocked_system_path(root / "subdir")
+        assert _is_blocked_workspace_path(root, str(root))
+
+    def test_windows_dir_subpath_blocked(self):
+        system_root = os.environ.get("SystemRoot") or os.environ.get("WINDIR")
+        if not system_root:
+            pytest.skip("SystemRoot is not set")
+        assert _is_blocked_system_path(Path(system_root) / "System32" / "drivers")
+
+
+class TestRemotePosixPathsStillBlocked:
+    """Remote terminal profiles may target a POSIX host from a Windows UI."""
+
+    @pytest.mark.parametrize(
+        "remote",
+        ["/etc", "/etc/ssh", "/dev/sda", "/usr/local/bin", "/bin/sh", "/Library/Fonts"],
+    )
+    def test_posix_shape_rejected(self, remote):
+        assert _is_blocked_workspace_path(Path(remote), remote)

+def _windows_blocked_roots() -> tuple[str, ...]:
+    """Native Windows system directories that must never be workspaces.
+
+    POSIX root names are *drive-relative* on Windows: ``Path('/dev')`` is
+    ``\\dev`` and ``.resolve()`` anchors it to the current drive, so the old
+    ``/dev`` entry rejected legitimate projects such as ``D:\\dev\\my-repo``
+    with "Path points to a system directory".  Windows therefore needs its
+    own blocklist of real system directories instead of the POSIX names.
+    """
+    raw: list[str] = []
+    for env_name in (
+        'SystemRoot',
+        'WINDIR',
+        'ProgramFiles',
+        'ProgramFiles(x86)',
+        'ProgramW6432',
+        'ProgramData',
+    ):
+        value = os.environ.get(env_name)
+        if value and value not in raw:
+            raw.append(value)
+    return tuple(raw)
+

@@ -0,0 +1,1019 @@
+"""Dependency-free YAML 1.1 subset: the opt-in last-resort backend for api.yaml_compat.
+
+Why this module exists. Hermes WebUI needs a YAML parser for config.yaml, profiles and
+workspaces.json-adjacent state, and api/yaml_compat.py only knows two backends: PyYAML
+and ruamel.yaml. On a host with no package index reachable (air-gapped box, restricted
+sandbox, a fresh venv before pip works) NEITHER can be installed, and ``import server``
+dies in api/profiles.py before the first request. That makes a source checkout
+impossible to deploy. This module keeps such a checkout bootable with the standard
+library alone.
+
+It is opt-in (HERMES_WEBUI_YAML_MINI=1, see yaml_compat.py) so that a checkout which is
+missing its dependencies still fails the way upstream expects: bare ``import yaml``
+semantics, i.e. ImportError. Install PyYAML (or ruamel.yaml) and unset the flag and this
+file stops being imported -- the backend order stays pyyaml > ruamel > mini.
+
+Scope, and how it fails. It implements the block-style subset that PyYAML itself writes
+for Hermes configs: nested mappings, block and flow sequences, flow collections,
+plain/single/double quoted scalars, literal and folded block scalars, comments, document
+markers, and PyYAML's YAML 1.1 implicit typing (on/off/yes/no are booleans, bare y/n stay
+strings, 010 is octal, 1e3 stays a string, dates are datetime.date, duplicate keys keep
+the last value).
+
+Anchors, aliases, merge keys (<<), tags (!!str), explicit keys (?), directives (%YAML),
+and multi-document streams are NOT implemented. Those raise UnsupportedYAMLError rather
+than being guessed at: every WebUI load site treats a parse failure as "empty config", so
+a silently wrong parse would let the next save truncate a user's config.yaml. Parse
+faithfully or fail loudly -- that is the whole rule here.
+"""
+
+from __future__ import annotations
+
+import datetime
+import math
+import re
+
+BACKEND = "mini"
+
+
+class MiniYAMLError(Exception):
+    """The document could not be parsed faithfully."""
+
+
+class UnsupportedYAMLError(MiniYAMLError):
+    """The document needs YAML features this module deliberately does not implement."""
+
+
+class RepresenterError(MiniYAMLError):
+    """A Python value cannot be emitted as YAML."""
+
+
+# -- implicit typing: copied from PyYAML's yaml/resolver.py (YAML 1.1 tables) --
+_BOOL_RE = re.compile(
+    r"^(?:yes|Yes|YES|no|No|NO|true|True|TRUE|false|False|FALSE|on|On|ON|off|Off|OFF)$")
+_INT_RE = re.compile(
+    r"^(?:[-+]?0b[0-1_]+|[-+]?0[0-7_]+|[-+]?(?:0|[1-9][0-9_]*)"
+    r"|[-+]?0x[0-9a-fA-F_]+|[-+]?[1-9][0-9_]*(?::[0-5]?[0-9])+)$")
+_FLOAT_RE = re.compile(
+    r"^(?:[-+]?(?:[0-9][0-9_]*)\.[0-9_]*(?:[eE][-+][0-9]+)?"
+    r"|\.[0-9][0-9_]*(?:[eE][-+][0-9]+)?"
+    r"|[-+]?[0-9][0-9_]*(?::[0-5]?[0-9])+\.[0-9_]*"
+    r"|[-+]?\.(?:inf|Inf|INF)|\.(?:nan|NaN|NAN))$")
+_TIMESTAMP_DATE_RE = re.compile(r"^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$")
+_TIMESTAMPT_RE = re.compile(
+    r"^[0-9][0-9][0-9][0-9]-[0-9][0-9]?-[0-9][0-9]?(?:[Tt]|[ \t]+)[0-9][0-9]?:[0-9][0-9]"
+    r":[0-9][0-9](?:\.[0-9]*)?(?:[ \t]*(?:Z|[-+][0-9][0-9]?(?::[0-9][0-9])?))?$")
+
+
+def _is_timestamp(text):
+    return bool(_TIMESTAMP_DATE_RE.match(text) or _TIMESTAMPT_RE.match(text))
+
+
+_TIMESTAMP_PARTS = re.compile(
+    r"^([0-9]{4})-([0-9]{1,2})-([0-9]{1,2})(?:(?:[Tt]|[ \t]+)([0-9]{1,2}):([0-9]{2})"
+    r":([0-9]{2})(?:\.([0-9]*))?(?:[ \t]*(Z|([-+])([0-9]{1,2})(?::([0-9]{2}))?)?)?)?$")
+
+_NULL_WORDS = ("", "~", "null", "Null", "NULL")
+
+
+def _construct_int(text):
+    value = text.replace("_", "")
+    sign = -1 if value[0] == "-" else 1
+    if value[0] in "+-":
+        value = value[1:]
+    if value.startswith("0b"):
+        return sign * int(value[2:], 2)
+    if value.startswith("0x"):
+        return sign * int(value[2:], 16)
+    if ":" in value:
+        total = 0
+        for part in value.split(":"):
+            total = total * 60 + int(part)
+        return sign * total
+    if value.startswith("0") and len(value) > 1:
+        return sign * int(value, 8)
+    return sign * int(value)
+
+
+def _construct_float(text):
+    value = text.replace("_", "")
+    sign = -1 if value[0] == "-" else 1
+    if value[0] in "+-":
+        value = value[1:]
+    lowered = value.lower()
+    if lowered == ".inf":
+        return math.inf if sign > 0 else -math.inf
+    if lowered == ".nan":
+        return math.nan
+    if ":" in value:
+        total = 0.0
+        for part in value.split(":"):
+            total = total * 60 + float(part)
+        return sign * total
+    return sign * float(value)
+
+
+def _construct_timestamp(text):
+    match = _TIMESTAMP_PARTS.match(text)
+    if match is None:
+        return text
+    year, month, day, hour, minute, second, frac, zone, tz_sign, tz_hour, tz_minute = match.groups()
+    if hour is None:
+        return datetime.date(int(year), int(month), int(day))
+    micro = 0
+    if frac:
+        micro = int((frac + "000000")[:6])
+    stamp = datetime.datetime(int(year), int(month), int(day),
+                              int(hour), int(minute), int(second), micro)
+    if zone == "Z":
+        return stamp.replace(tzinfo=datetime.timezone.utc)
+    if tz_sign:
+        delta = datetime.timedelta(hours=int(tz_hour or 0), minutes=int(tz_minute or 0))
+        if tz_sign == "-":
+            delta = -delta
+        return stamp.replace(tzinfo=datetime.timezone(delta))
+    return stamp
+
+
+def _resolve_plain(text):
+    """PyYAML SafeLoader resolution for an unquoted scalar."""
+    if text in _NULL_WORDS:
+        return None
+    if _BOOL_RE.match(text):
+        return text.lower() in ("yes", "true", "on")
+    if _INT_RE.match(text):
+        return _construct_int(text)
+    if _FLOAT_RE.match(text):
+        return _construct_float(text)
+    if _is_timestamp(text):
+        return _construct_timestamp(text)
+    return text
+
+
+# -- lexical helpers -----------------------------------------------------------
+_DOUBLE_ESCAPES = {
+    "0": "\x00", "a": "\x07", "b": "\x08", "t": "\t", "\t": "\t", "n": "\n",
+    "v": "\x0b", "f": "\x0c", "r": "\r", "e": "\x1b", " ": " ", '"': '"',
+    "/": "/", "\\": "\\", "N": "\x85", "_": "\xa0", "L": "\u2028", "P": "\u3029",
+}
+
+
+def _strip_comment(text):
+    """Drop a trailing ``# ...`` comment from a scalar line (outside quotes)."""
+    quote = None
+    index = 0
+    length = len(text)
+    while index < length:
+        char = text[index]
+        if quote:
+            if char == "\\" and quote == '"':
+                index += 2
+                continue
+            if char == quote:
+                if quote == "'" and text[index + 1:index + 2] == "'":
+                    index += 1
+                else:
+                    quote = None
+            index += 1
+            continue
+        if char in ("'", '"'):
+            quote = char
+        elif char == "#" and (index == 0 or text[index - 1] in " \t"):
+            return text[:index].rstrip()
+        index += 1
+    return text.rstrip()
+
+
+def _is_seq_entry(body):
+    return body == "-" or (body[:1] == "-" and body[1:2] in (" ", "\t"))
+
+
+def _split_key(body):
+    """Return (key_text, rest) when ``body`` opens a mapping entry, else None."""
+    if body.startswith("? "):
+        raise UnsupportedYAMLError("explicit mapping keys ('? ') are not supported")
+    depth = 0
+    quote = None
+    index = 0
+    length = len(body)
+    while index < length:
+        char = body[index]
+        if quote:
+            if char == "\\" and quote == '"':
+                index += 2
+                continue
+            if char == quote:
+                if quote == "'" and body[index + 1:index + 2] == "'":
+                    index += 1
+                else:
+                    quote = None
+            index += 1
+            continue
+        if char in ("'", '"'):
+            quote = char
+        elif char in "[{":
+            depth += 1
+        elif char in "]}":
+            depth -= 1
+        elif char == "#" and (index == 0 or body[index - 1] in " \t"):
+            break
+        elif char == ":" and depth == 0:
+            follower = body[index + 1:index + 2]
+            if follower in ("", " ", "\t"):
+                return body[:index].rstrip(), body[index + 1:].strip()
+        index += 1
+    return None
+
+
+def _scan_quoted(text, start):
+    """Walk a quoted scalar from the opening quote. Return (end_index, closed)."""
+    quote = text[start]
+    index = start + 1
+    length = len(text)
+    while index < length:
+        char = text[index]
+        if quote == '"':
+            if char == "\\":
+                index += 2
+                continue
+            if char == '"':
+                return index, True
+        else:
+            if char == "'":
+                if text[index + 1:index + 2] == "'":
+                    index += 2
+                    continue
+                return index, True
+        index += 1
+    return length, False
+
+
+def _unquote(text):
+    """Decode a complete quoted scalar (single line, quotes included)."""
+    if len(text) < 2 or text[0] != text[-1]:
+        raise MiniYAMLError("malformed quoted scalar: %r" % (text,))
+    body = text[1:-1]
+    if text[0] == "'":
+        return body.replace("''", "'")
+    out = []
+    index = 0
+    length = len(body)
+    while index < length:
+        char = body[index]
+        if char != "\\":
+            out.append(char)
+            index += 1
+            continue
+        index += 1
+        if index >= length:
+            raise MiniYAMLError("trailing backslash in double-quoted scalar")
+        marker = body[index]
+        if marker in ("x", "u", "U"):
+            digits = {"x": 2, "u": 4, "U": 8}[marker]
+            raw = body[index + 1:index + 1 + digits]
+            if len(raw) != digits:
+                raise MiniYAMLError("truncated \\%s escape in double-quoted scalar" % marker)
+            out.append(chr(int(raw, 16)))
+            index += 1 + digits
+            continue
+        if marker == "\n":
+            while index < length and body[index] in " \t\n":
+                index += 1
+            continue
+        if marker not in _DOUBLE_ESCAPES:
+            raise MiniYAMLError("unknown escape '\\%s' in double-quoted scalar" % marker)
+        out.append(_DOUBLE_ESCAPES[marker])
+        index += 1
+    return "".join(out)
+
+
+def _flow_state(text):
+    """Return (bracket_depth, open_quote_char_or_None) for a flow fragment."""
+    depth = 0
+    quote = None
+    index = 0
+    length = len(text)
+    while index < length:
+        char = text[index]
+        if quote:
+            if char == "\\" and quote == '"':
+                index += 2
+                continue
+            if char == quote:
+                if quote == "'" and text[index + 1:index + 2] == "'":
+                    index += 1
+                else:
+                    quote = None
+            index += 1
+            continue
+        if char in ("'", '"'):
+            quote = char
+        elif char in "[{":
+            depth += 1
+        elif char in "]}":
+            depth -= 1
+        index += 1
+    return depth, quote
+
+
+def _skip_space(text, index):
+    while index < len(text) and text[index] in " \t":
+        index += 1
+    return index
+
+
+def _flow_scalar(text, index):
+    """Read a quoted or plain scalar inside a flow collection."""
+    index = _skip_space(text, index)
+    if index >= len(text):
+        raise MiniYAMLError("unexpected end of flow collection")
+    char = text[index]
+    if char in ("'", '"'):
+        end, closed = _scan_quoted(text, index)
+        if not closed:
+            raise MiniYAMLError("unterminated quoted scalar in flow collection")
+        return _unquote(text[index:end + 1]), end + 1
+    if char in "&*!":
+        raise UnsupportedYAMLError("anchors, aliases and tags in flow collections "
+                                   "are not supported by the built-in YAML fallback")
+    start = index
+    while index < len(text) and text[index] not in ",]}":
+        if text[index] == ":" and text[index + 1:index + 2] in ("", " ", "\t"):
+            break
+        index += 1
+    return _resolve_plain(text[start:index].strip()), index
+
+
+def _flow_node(text, index):
+    """Parse one flow value (scalar, [..], {..}) starting at index."""
+    index = _skip_space(text, index)
+    if index >= len(text):
+        raise MiniYAMLError("unexpected end of flow collection")
+    char = text[index]
+    if char == "[":
+        items = []
+        index += 1
+        while True:
+            index = _skip_space(text, index)
+            if index >= len(text):
+                raise MiniYAMLError("unterminated flow sequence")
+            if text[index] == "]":
+                return items, index + 1
+            value, index = _flow_node(text, index)
+            items.append(value)
+            index = _skip_space(text, index)
+            if index < len(text) and text[index] == ",":
+                index += 1
+                continue
+            if index < len(text) and text[index] == "]":
+                return items, index + 1
+            raise MiniYAMLError("expected ',' or ']' in flow sequence")
+    if char == "{":
+        mapping = {}
+        index += 1
+        while True:
+            index = _skip_space(text, index)
+            if index >= len(text):
+                raise MiniYAMLError("unterminated flow mapping")
+            if text[index] == "}":
+                return mapping, index + 1
+            key, index = _flow_scalar(text, index)
+            index = _skip_space(text, index)
+            value = None
+            if index < len(text) and text[index] == ":":
+                value, index = _flow_node(text, index + 1)
+            if not isinstance(key, (str, int, float, bool, datetime.date, datetime.datetime)) \
+                    and key is not None:
+                raise UnsupportedYAMLError("complex mapping keys are not supported")
+            mapping[key] = value
+            index = _skip_space(text, index)
+            if index < len(text) and text[index] == ",":
+                index += 1
+                continue
+            if index < len(text) and text[index] == "}":
+                return mapping, index + 1
+            raise MiniYAMLError("expected ',' or '}' in flow mapping")
+    return _flow_scalar(text, index)
+
+
+# -- block parser --------------------------------------------------------------
+class _Reader:
+    """Indentation-driven parser for the block-style YAML subset."""
+
+    def __init__(self, text):
+        self.raw = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
+        if self.raw and self.raw[-1] == "":
+            # The final newline terminates the last line; it is not a blank line.
+            self.raw.pop()
+        self.cells = []
+        for number, line in enumerate(self.raw):
+            body = line.lstrip(" ")
+            self.cells.append([len(line) - len(body), body, number])
+        self.pos = 0
+
+    # -- cursor --
+    def peek(self):
+        while self.pos < len(self.cells):
+            indent, body, number = self.cells[self.pos]
+            if body == "" or body.startswith("#"):
+                self.pos += 1
+                continue
+            if body[:1] == "\t":
+                raise MiniYAMLError("tab characters cannot be used for indentation (line %d)"
+                                    % (number + 1))
+            return indent, body, number
+        return None
+
+    def _rewrite(self, number, indent, body):
+        self.cells[number] = [indent, body, number]
+
+    # -- document --
+    def parse_document(self):
+        head = self.peek()
+        if head is None:
+            return None
+        indent, body, number = head
+        if body.startswith("%"):
+            raise UnsupportedYAMLError("YAML directives are not supported (line %d)" % (number + 1))
+        if body == "---":
+            self.pos = number + 1
+            head = self.peek()
+            if head is None:
+                return None
+            indent, body, number = head
+        elif body.startswith("--- "):
+            self._rewrite(number, 4, _strip_comment(body[4:]).lstrip(" "))
+            indent, body, number = self.cells[number]
+        if body == "...":
+            return None
+        value = self._parse_block(indent)
+        self._check_trailing()
+        return value
+
+    def _check_trailing(self):
+        head = self.peek()
+        if head is None:
+            return
+        _indent, body, number = head
+        if body == "...":
+            self.pos = number + 1
+            if self.peek() is not None:
+                raise MiniYAMLError("unexpected content after '...' (line %d)"
+                                   % (self.peek()[2] + 1))
+            return
+        if body == "---" or body.startswith("--- "):
+            raise UnsupportedYAMLError("multi-document streams need yaml.safe_load_all; "
+                                       "the built-in fallback reads a single document (line %d)"
+                                       % (number + 1))
+        raise MiniYAMLError("unexpected top-level content (line %d): %s" % (number + 1, body[:60]))
+
+    # -- nodes --
+    def _parse_block(self, indent):
+        head = self.peek()
+        if head is None:
+            return None
+        line_indent, body, number = head
+        if line_indent < indent:
+            return None
+        if _is_seq_entry(body):
+            return self._parse_seq(line_indent)
+        if _split_key(body) is not None:
+            return self._parse_map(line_indent)
+        self.pos = number + 1
+        return self._parse_value(body, line_indent, number)
+
+    def _parse_seq(self, indent):
+        items = []
+        while True:
+            head = self.peek()
+            if head is None:
+                break
+            line_indent, body, number = head
+            if line_indent < indent:
+                break
+            if line_indent > indent:
+                raise MiniYAMLError("unexpected indentation in sequence (line %d)" % (number + 1))
+            if not _is_seq_entry(body):
+                break
+            tail = body[1:]
+            stripped = tail.lstrip(" ")
+            column = indent + 1 + (len(tail) - len(stripped))
+            if stripped == "" or stripped.startswith("#"):
+                self.pos = number + 1
+                items.append(self._parse_nested(indent))
+            else:
+                self._rewrite(number, column, stripped)
+                items.append(self._parse_block(column))
+            if self.pos <= number:
+                raise MiniYAMLError("could not make progress at line %d" % (number + 1))
+        return items
+
+    def _parse_map(self, indent):
+        mapping = {}
+        while True:
+            head = self.peek()
+            if head is None:
+                break
+            line_indent, body, number = head
+            if line_indent < indent:
+                break
+            if _is_seq_entry(body):
+                break
+            if line_indent > indent:
+                raise MiniYAMLError("unexpected indentation in mapping (line %d)" % (number + 1))
+            split = _split_key(body)
+            if split is None:
+                break
+            key_text, rest = split
+            if key_text[:1] in "&*!":
+                raise UnsupportedYAMLError("anchors and tags on keys are not supported (line %d)"
+                                           % (number + 1))
+            key = _parse_key_token(key_text, number)
+            self.pos = number + 1
+            if rest == "":
+                mapping[key] = self._parse_nested(indent)
+            else:
+                mapping[key] = self._parse_value(rest, line_indent, number)
+            if self.pos <= number:
+                raise MiniYAMLError("could not make progress at line %d" % (number + 1))
+        return mapping
+
+    def _parse_nested(self, indent):
+        """Value of a 'key:' / '-' line that continues on following lines."""
+        head = self.peek()
+        if head is None:
+            return None
+        deeper, body, _number = head
+        if deeper > indent:
+            return self._parse_block(deeper)
+        if deeper == indent and _is_seq_entry(body):
+            return self._parse_seq(indent)
+        return None
+
+    def _parse_value(self, text, line_indent, number):
+        text = text.strip()
+        if text == "":
+            return self._parse_nested(line_indent)
+        marker = text[0]
+        if marker in "&*":
+            raise UnsupportedYAMLError("anchors and aliases are not supported by the built-in "
+                                       "YAML fallback (line %d); install PyYAML" % (number + 1))
+        if marker == "!":
+            raise UnsupportedYAMLError("explicit tags are not supported by the built-in "
+                                       "YAML fallback (line %d); install PyYAML" % (number + 1))
+        if marker in "|>":
+            return self._parse_block_scalar(text, line_indent, number)
+        if marker in "[{":
+            return self._parse_flow(text, number)
+        if marker in "'\"":
+            return self._parse_multiline_quoted(text, number, line_indent)
+        return self._parse_plain(text, number, line_indent)
+
+    def _parse_flow(self, text, number):
+        buffer = text
+        while True:
+            depth, open_quote = _flow_state(buffer)
+            if depth <= 0 and open_quote is None:
+                break
+            head = self.peek()
+            if head is None:
+                raise MiniYAMLError("unterminated flow collection (line %d)" % (number + 1))
+            _indent, body, index = head
+            buffer += " " + body
+            self.pos = index + 1
+        depth, open_quote = _flow_state(buffer)
+        if depth < 0 or open_quote:
+            raise MiniYAMLError("unbalanced flow collection (line %d)" % (number + 1))
+        value, consumed = _flow_node(buffer, 0)
+        remainder = buffer[consumed:].strip()
+        if remainder and not remainder.startswith("#") and remainder not in ("]", "}"):
+            raise MiniYAMLError("unexpected trailing content after flow value (line %d)"
+                                % (number + 1))
+        return value
+
+    def _parse_multiline_quoted(self, text, number, line_indent):
+        buffer = text
+        while True:
+            end, closed = _scan_quoted(buffer, 0)
+            if closed:
+                tail = buffer[end + 1:].strip()
+                if tail and not tail.startswith("#"):
+                    raise MiniYAMLError("unexpected content after a quoted scalar (line %d): %s"
+                                        % (number + 1, tail[:40]))
+                return _unquote(buffer[:end + 1])
+            head = self.peek()
+            if head is None:
+                raise MiniYAMLError("unterminated quoted scalar (line %d)" % (number + 1))
+            _indent, body, index = head
+            joiner = "" if buffer.endswith("\\") else " "
+            buffer = buffer.rstrip() + joiner + body
+            self.pos = index + 1
+
+    def _parse_plain(self, text, number, line_indent):
+        value = _strip_comment(text)
+        if value == "":
+            return self._parse_nested(line_indent)
+        parts = [value]
+        while True:
+            head = self.peek()
+            if head is None:
+                break
+            deeper, body, index = head
+            if deeper <= line_indent:
+                break
+            if _is_seq_entry(body) or _split_key(body) is not None:
+                break
+            if body[0] in "|>[]{}&*!":
+                break
+            continued = _strip_comment(body)
+            if continued == "":
+                break
+            parts.append(continued)
+            self.pos = index + 1
+        if len(parts) == 1:
+            return _resolve_plain(value)
+        return " ".join(parts)
+
+    def _parse_block_scalar(self, header, line_indent, number):
+        style = header[0]
+        spec = _strip_comment(header[1:]).strip()
+        chomp = "clip"
+        explicit = None
+        for char in spec:
+            if char == "-":
+                chomp = "strip"
+            elif char == "+":
+                chomp = "keep"
+            elif char.isdigit():
+                explicit = int(char)
+            else:
+                raise MiniYAMLError("bad block scalar header %r (line %d)" % (header, number + 1))
+        base = None if explicit is None else line_indent + explicit
+        collected = []
+        index = number + 1
+        while index < len(self.raw):
+            line = self.raw[index]
+            if line.strip() == "":
+                collected.append("")
+                index += 1
+                continue
+            indent = len(line) - len(line.lstrip(" "))
+            if base is None:
+                if indent <= line_indent:
+                    break
+                base = indent
+            if indent < base:
+                if indent <= line_indent:
+                    break
+                raise MiniYAMLError("inconsistent indentation in block scalar (line %d)"
+                                    % (index + 1))
+            collected.append(line[base:])
+            index += 1
+        self.pos = index
+        content = list(collected)
+        trailing = 0
+        while content and content[-1] == "":
+            content.pop()
+            trailing += 1
+        return _block_body(style, content, chomp, trailing)
+
+
+def _block_body(style, content, chomp, trailing):
+    """Assemble a block scalar body, then apply the chomping indicator."""
+    if style == "|":
+        text = "\n".join(content)
+    else:
+        text = ""
+        started = False
+        breaks = 0
+        previous_literal = False
+        for line in content:
+            if line == "":
+                if started:
+                    breaks += 1
+                continue
+            literal = line[:1] in (" ", "\t")
+            if started:
+                if breaks:
+                    text += "\n" * breaks
+                elif literal or previous_literal:
+                    text += "\n"
+                else:
+                    text += " "
+            text += line
+            started = True
+            breaks = 0
+            previous_literal = literal
+    if not content or text == "":
+        return ""
+    if chomp == "strip":
+        return text
+    if chomp == "keep":
+        return text + "\n" * (1 + trailing)
+    return text + "\n"
+
+
+def _parse_key_token(text, number):
+    text = text.strip()
+    if text == "":
+        raise MiniYAMLError("empty mapping key (line %d)" % (number + 1))
+    if text[0] in "'\"":
+        _end, closed = _scan_quoted(text, 0)
+        if not closed:
+            raise MiniYAMLError("unterminated quoted key (line %d)" % (number + 1))
+        return _unquote(text)
+    if text[0] in "[{":
+        raise UnsupportedYAMLError("flow-style mapping keys are not supported by the "
+                                   "built-in YAML fallback (line %d)" % (number + 1))
+    if text == "<<":
+        raise UnsupportedYAMLError("merge keys ('<<') are not supported by the built-in "
+                                   "YAML fallback (line %d); install PyYAML" % (number + 1))
+    return _resolve_plain(text)
+
+
+# -- emitter -------------------------------------------------------------------
+_UNSAFE_START = "-?:,[]{}#&*!|>'\"%@`"
+
+
+def _is_plain_safe(text):
+    """True when ``text`` round-trips as a string with no quotes."""
+    if text == "" or text != text.strip():
+        return False
+    if not isinstance(_resolve_plain(text), str):
+        return False
+    head = text[0]
+    if head in _UNSAFE_START:
+        if not (head in "-?:" and len(text) > 1 and text[1] not in " \t"):
+            return False
+    if ": " in text or " #" in text or text.endswith(":"):
+        return False
+    for char in text:
+        if ord(char) < 0x20 or char == "\x7f":
+            return False
+    return True
+
+
+def _quote_single(text):
+    return "'" + text.replace("'", "''") + "'"
+
+
+def _quote_double(text, allow_unicode):
+    out = ['"']
+    for char in text:
+        code = ord(char)
+        if char == '"':
+            out.append('\\"')
+        elif char == "\\":
+            out.append("\\\\")
+        elif char == "\n":
+            out.append("\\n")
+        elif char == "\t":
+            out.append("\\t")
+        elif char == "\r":
+            out.append("\\r")
+        elif code < 0x20:
+            out.append("\\x%02x" % code)
+        elif code > 0x7E and not allow_unicode:
+            if code <= 0xFF:
+                out.append("\\x%02x" % code)
+            elif code <= 0xFFFF:
+                out.append("\\u%04x" % code)
+            else:
+                out.append("\\U%08x" % code)
+        else:
+            out.append(char)
+    out.append('"')
+    return "".join(out)
+
+
+def _string_scalar(text, allow_unicode):
+    if not allow_unicode and any(ord(char) > 0x7E for char in text):
+        return _quote_double(text, allow_unicode)
+    if _is_plain_safe(text):
+        return text
+    printable = all(ord(char) >= 0x20 for char in text)
+    if printable and (allow_unicode or all(ord(char) <= 0x7E for char in text)):
+        return _quote_single(text)
+    return _quote_double(text, allow_unicode)
+
+
+def _block_literal(text, allow_unicode):
+    """Return (header, lines) when ``text`` is safe to emit as a literal block."""
+    if "\n" not in text or "\r" in text or text[:1] in (" ", "\t"):
+        return None
+    if not allow_unicode and any(ord(char) > 0x7E for char in text):
+        return None
+    for line in text.split("\n"):
+        if line != line.rstrip(" \t") or line[:1] == "\t":
+            return None
+    trailing = len(text) - len(text.rstrip("\n"))
+    header = "|" if trailing == 1 else ("|+" if trailing >= 2 else "|-")
+    lines = text.split("\n")
+    if trailing:
+        lines = lines[:-trailing]
+    return header, lines
+
+
+def _scalar_repr(value, allow_unicode):
+    if value is None:
+        return "null"
+    if isinstance(value, bool):
+        return "true" if value else "false"
+    if isinstance(value, int):
+        return str(value)
+    if isinstance(value, float):
+        if math.isnan(value):
+            return ".nan"
+        if math.isinf(value):
+            return ".inf" if value > 0 else "-.inf"
+        return repr(value)
+    if isinstance(value, str):
+        return _string_scalar(value, allow_unicode)
+    if isinstance(value, datetime.datetime):
+        return value.isoformat(sep=" ")
+    if isinstance(value, datetime.date):
+        return value.isoformat()
+    raise RepresenterError("cannot represent an object of type %s with the built-in "
+                           "YAML fallback; install PyYAML" % type(value).__name__)
+
+
+def _sorted_items(mapping, sort_keys):
+    items = list(mapping.items())
+    if not sort_keys:
+        return items
+    try:
+        return sorted(items)
+    except TypeError:
+        return sorted(items, key=lambda pair: str(pair[0]))
+
+
+def _flow_repr(value, allow_unicode, sort_keys):
+    if isinstance(value, dict):
+        parts = []
+        for key, item in _sorted_items(value, sort_keys):
+            parts.append("%s: %s" % (_scalar_repr(key, allow_unicode),
+                                     _flow_repr(item, allow_unicode, sort_keys)))
+        return "{" + ", ".join(parts) + "}"
+    if isinstance(value, (list, tuple)):
+        return "[" + ", ".join(_flow_repr(item, allow_unicode, sort_keys) for item in value) + "]"
+    return _scalar_repr(value, allow_unicode)
+
+
+def _render_value(lines, head, col, value, allow_unicode, sort_keys, step):
+    """Append ``head`` plus its value to ``lines`` (mapping-entry style)."""
+    if isinstance(value, dict):
+        if not value:
+            lines.append(head + " {}")
+            return
+        lines.append(head)
+        lines.extend(_render_mapping(value, col + step, allow_unicode, sort_keys, step))
+        return
+    if isinstance(value, (list, tuple)):
+        if not value:
+            lines.append(head + " []")
+            return
+        lines.append(head)
+        lines.extend(_render_sequence(list(value), col, allow_unicode, sort_keys, step))
+        return
+    if isinstance(value, str):
+        block = _block_literal(value, allow_unicode)
+        if block is not None:
+            header, body = block
+            lines.append(head + " " + header)
+            lines.extend(_indented(body, col + step))
+            return
+    lines.append(head + " " + _scalar_repr(value, allow_unicode))
+
+
+def _indented(lines, col):
+    return ["" if line == "" else " " * col + line for line in lines]
+
+
+def _render_mapping(mapping, col, allow_unicode, sort_keys, step):
+    if not mapping:
+        return [" " * col + "{}"]
+    lines = []
+    for key, value in _sorted_items(mapping, sort_keys):
+        head = " " * col + _scalar_repr(key, allow_unicode) + ":"
+        _render_value(lines, head, col, value, allow_unicode, sort_keys, step)
+    return lines
+
+
+def _render_sequence(sequence, col, allow_unicode, sort_keys, step):
+    if not sequence:
+        return [" " * col + "[]"]
+    dash = " " * col + "- "
+    lines = []
+    for item in sequence:
+        if isinstance(item, dict) and item:
+            block = _render_mapping(item, col + 2, allow_unicode, sort_keys, step)
+            lines.append(dash + block[0].lstrip())
+            lines.extend(block[1:])
+        elif isinstance(item, (list, tuple)) and item:
+            block = _render_sequence(list(item), col + 2, allow_unicode, sort_keys, step)
+            lines.append(dash + block[0].lstrip())
+            lines.extend(block[1:])
+        elif isinstance(item, dict):
+            lines.append(dash + "{}")
+        elif isinstance(item, (list, tuple)):
+            lines.append(dash + "[]")
+        else:
+            block = _block_literal(item, allow_unicode) if isinstance(item, str) else None
+            if block is not None:
+                header, body = block
+                lines.append(" " * col + "- " + header)
+                lines.extend(_indented(body, col + max(step, 2)))
+            else:
+                lines.append(dash + _scalar_repr(item, allow_unicode))
+    return lines
+
+
+# -- public API ----------------------------------------------------------------
+YAMLError = MiniYAMLError
+MarkedYAMLError = MiniYAMLError
+
+
+def _read_stream(stream):
+    if stream is None:
+        return None
+    if isinstance(stream, str):
+        return stream
+    if isinstance(stream, bytes):
+        return stream.decode("utf-8")
+    reader = getattr(stream, "read", None)
+    if callable(reader):
+        data = reader()
+        if isinstance(data, bytes):
+            return data.decode("utf-8")
+        return data
+    raise MiniYAMLError("expected str, bytes or a file-like object, got %s"
+                       % type(stream).__name__)
+
+
+def safe_load(stream):
+    """Parse one YAML document into plain Python containers (YAML 1.1 rules)."""
+    text = _read_stream(stream)
+    if text is None:
+        return None
+    if text.startswith("\ufeff"):
+        text = text[1:]
+    return _Reader(text).parse_document()
+
+
+def load(stream, Loader=None):
+    """``yaml.load`` with no custom Loader: identical to safe_load for our purposes."""
+    if Loader is not None:
+        raise UnsupportedYAMLError("custom Loader classes are not supported by the "
+                                   "built-in YAML fallback")
+    return safe_load(stream)
+
+
+def safe_dump(data, stream=None, *, default_flow_style=False, allow_unicode=False,
+              sort_keys=True, indent=None, width=None):
+    """Emit plain Python containers as block YAML.
+
+    ``width`` is accepted for call-site parity and ignored: the fallback never folds
+    lines, and an unfolded line is still valid YAML that PyYAML reads back unchanged.
+    """
+    step = int(indent) if indent else 2
+    if isinstance(data, dict):
+        if not data:
+            text = "{}\n"
+        elif default_flow_style:
+            text = _flow_repr(data, allow_unicode, sort_keys) + "\n"
+        else:
+            text = "\n".join(_render_mapping(data, 0, allow_unicode, sort_keys, step)) + "\n"
+    elif isinstance(data, (list, tuple)):
+        items = list(data)
+        if not items:
+            text = "[]\n"
+        elif default_flow_style:
+            text = _flow_repr(items, allow_unicode, sort_keys) + "\n"
+        else:
+            text = "\n".join(_render_sequence(items, 0, allow_unicode, sort_keys, step)) + "\n"
+    else:
+        text = _scalar_repr(data, allow_unicode) + "\n"
+    if stream is None:
+        return text
+    stream.write(text)
+    return None
+
+
+def dump(data, stream=None, *, default_flow_style=False, allow_unicode=False,
+         sort_keys=True, indent=None, width=None):
+    """``yaml.dump``: the fallback has no tag machinery, so this is safe_dump."""
+    return safe_dump(data, stream, default_flow_style=default_flow_style,
+                     allow_unicode=allow_unicode, sort_keys=sort_keys,
+                     indent=indent, width=width)
+
+
+def safe_dump_all(documents, stream=None, **kwargs):
+    for index, document in enumerate(documents):
+        text = safe_dump(document, None, **kwargs)
+        chunk = ("--- " if index else "") + text
+        if stream is None:
+            yield chunk
+        else:
+            stream.write(chunk)
+    if stream is not None:
+        return None

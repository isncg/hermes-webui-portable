+def test_flow_collections_and_nested_styles():
+    doc = ("l: [1, two, 'three', 4.5]\nm: {a: 1, b: [2, 3], c: {d: e}}\n"
+           "empty_l: []\nempty_m: {}\nnested: [[1, 2], [3]]\n")
+    assert yaml_mini.safe_load(doc) == {
+        "l": [1, "two", "three", 4.5],
+        "m": {"a": 1, "b": [2, 3], "c": {"d": "e"}},
+        "empty_l": [], "empty_m": {}, "nested": [[1, 2], [3]],
+    }
+    assert yaml_mini.safe_load("m: {a: 1,\n    b: 2}\n") == {"m": {"a": 1, "b": 2}}
+

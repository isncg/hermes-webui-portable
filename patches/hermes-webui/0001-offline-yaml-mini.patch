+def test_unsupported_features_fail_loudly_instead_of_guessing():
+    for doc in ("b: &b {x: 1}\nm:\n  <<: *b\n",
+                "s: !!str 1\n",
+                "a: 1\n--- \nb: 2\n",
+                "%YAML 1.1\na: 1\n",
+                "? [a, b]\n: c\n"):
+        with pytest.raises(yaml_mini.MiniYAMLError):
+            yaml_mini.safe_load(doc)

+def test_corpus_of_real_yaml_files_round_trips():
+    import os
+
+    paths = []
+    roots = [REPO / "api", REPO / ".github"]
+    # The sibling hermes-agent checkout, wherever this pair is unzipped:
+    #   <base>/hermes-webui/<repo>/  +  <base>/hermes-agent/<version>/
+    for candidate in (REPO.parents[1] / "hermes-agent", REPO.parent / "hermes-agent"):
+        if candidate.is_dir():
+            roots.append(candidate)
+            break
+    for root in roots:
+        if not root.exists():
+            continue
+        for dirpath, dirnames, filenames in os.walk(root):
+            dirnames[:] = [d for d in dirnames if d not in ("node_modules", ".git", "venv", "__pycache__")]
+            for name in filenames:
+                if name.endswith((".yaml", ".yml")):
+                    paths.append(Path(dirpath) / name)
+    if not paths:
+        pytest.skip("no YAML corpus available")
+    parsed = unsupported = 0
+    for path in paths:
+        text = path.read_text(encoding="utf-8", errors="replace")
+        try:
+            data = yaml_mini.safe_load(text)
+        except yaml_mini.UnsupportedYAMLError as error:
+            unsupported += 1
+            assert "anchors and aliases are not supported" in str(error), path
+            continue
+        parsed += 1
+        assert yaml_mini.safe_load(yaml_mini.safe_dump(data, sort_keys=False,
+                                                      allow_unicode=True)) == data, path
+    assert parsed >= 50, parsed
+
+
+def test_compat_gates_the_fallback_behind_an_env_flag(monkeypatch):
+    for name in ("yaml", "ruamel", "ruamel.yaml", "api.yaml_compat", "api.yaml_mini"):
+        monkeypatch.delitem(sys.modules, name, raising=False)
+    monkeypatch.delenv("HERMES_WEBUI_YAML_MINI", raising=False)
+    monkeypatch.setenv("PATH", "")  # nothing to import: neither backend exists
+    with pytest.raises(ImportError):
+        importlib_import_compat()
+    monkeypatch.setenv("HERMES_WEBUI_YAML_MINI", "1")
+    module = importlib_import_compat()
+    assert module.BACKEND == "mini"
+    assert module.safe_load("a: 1") == {"a": 1}
+
+
+def importlib_import_compat():
+    import importlib
+
+    sys.path.insert(0, str(REPO))
+    return importlib.import_module("api.yaml_compat")
+
+
+def run_tests():
+    failures = []
+    skipped = []
+    for name in sorted(globals()):
+        if not name.startswith("test_") or name == "run_tests":
+            continue
+        func = globals()[name]
+        if name == "test_compat_gates_the_fallback_behind_an_env_flag":
+            continue  # needs a pytest monkeypatch fixture
+        try:
+            func()
+        except _Skipped as exc:
+            skipped.append("%s: %s" % (name, exc))
+        except Exception as exc:  # noqa: BLE001 - the point of the runner
+            failures.append("%s: %s: %s" % (name, type(exc).__name__, str(exc)[:200]))
+    print("yaml_mini tests: %d failed, %d skipped" % (len(failures), len(skipped)))
+    for line in failures:
+        print("  FAIL " + line)
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(run_tests())

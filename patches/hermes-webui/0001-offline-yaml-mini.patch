+def test_multiline_quoted_scalars_fold():
+    assert yaml_mini.safe_load('v: "one\n  two"\n') == {"v": "one two"}
+    assert yaml_mini.safe_load("v: 'it''s\n  fine'\n") == {"v": "it's fine"}

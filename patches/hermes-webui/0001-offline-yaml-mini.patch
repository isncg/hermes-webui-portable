+def test_double_quoted_escapes():
+    doc = "v: " + chr(34) + r"a\tb\nc\xe9\x41z" + chr(34) + chr(10)
+    assert yaml_mini.safe_load(doc) == {'v': "a\tb\nc" + chr(0xE9) + "Az"}

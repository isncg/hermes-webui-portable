+def test_dump_escapes_non_ascii_when_allow_unicode_false():
+    text = yaml_mini.safe_dump({"name": "café"}, sort_keys=False)
+    assert "caf" in text and "é" not in text
+    assert yaml_mini.safe_load(text) == {"name": "café"}

+﻿"""api.yaml_mini: the opt-in, dependency-free YAML backend for offline deployments.
+
+Runs with the standard library alone (pytest optional): ``python tests/test_yaml_mini_fallback.py``
+executes every test_ function and prints a summary.
+"""
+
+import datetime
+import io
+import os
+import sys
+from pathlib import Path
+
+try:
+    import pytest
+except ModuleNotFoundError:  # standalone run: python tests/test_yaml_mini_fallback.py
+    class _Skipped(Exception):
+        pass
+
+    class _RaisesCtx:
+        def __init__(self, expected):
+            self.expected = expected
+
+        def __enter__(self):
+            return self
+
+        def __exit__(self, exc_type, exc, tb):
+            if exc_type is None:
+                raise AssertionError("DID NOT RAISE %s" % getattr(self.expected, "__name__", self.expected))
+            if not issubclass(exc_type, self.expected):
+                return False
+            return True
+
+    class _PytestShim:
+        raises = staticmethod(_RaisesCtx)
+
+        @staticmethod
+        def skip(reason=""):
+            raise _Skipped(reason)
+
+    pytest = _PytestShim()
+    _Skipped = _Skipped  # noqa: N816
+else:
+    class _Skipped(Exception):
+        pass
+
+REPO = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(REPO))
+
+from api import yaml_mini  # noqa: E402
+
+
+CFG = {
+    "model": {"default": "claude-opus", "provider": "anthropic"},
+    "toolsets": ["web", "terminal"],
+    "webui_chat_backend": "gateway",
+    "webui_gateway_use_runs_api": True,
+    "name": "café",
+    "count": 3,
+    "empty": None,
+}
+
+
+def test_round_trip_config_tree():
+    text = yaml_mini.safe_dump(CFG, sort_keys=False, allow_unicode=True)
+    assert yaml_mini.safe_load(text) == CFG
+    assert "café" in text
+
+
+def test_round_trip_accepts_stream_and_empty():
+    text = yaml_mini.safe_dump(CFG, allow_unicode=True)
+    assert yaml_mini.safe_load(io.StringIO(text)) == CFG
+    assert yaml_mini.safe_dump(CFG, io.StringIO(), allow_unicode=True) is None
+    assert yaml_mini.safe_load("") is None
+    assert yaml_mini.safe_load("# just a comment\n") is None
+
+
+def test_yaml11_implicit_typing_matches_pyyaml():
+    doc = ("tool_progress: off\nshow_reasoning: no\nstreaming: on\nauto: yes\n"
+           "quoted: 'off'\nbare_y: y\nbare_n: n\noctal: 010\nhex: 0x1F\n"
+           "sexagesimal: 1:30\nunderscored: 1_000\nsci: 1e3\nfloat: 1.5\n"
+           "inf: .inf\nnothing: ~\ntilde:\n")
+    assert yaml_mini.safe_load(doc) == {
+        "tool_progress": False, "show_reasoning": False, "streaming": True,
+        "auto": True, "quoted": "off", "bare_y": "y", "bare_n": "n",
+        "octal": 8, "hex": 31, "sexagesimal": 90, "underscored": 1000,
+        "sci": "1e3", "float": 1.5, "inf": float("inf"), "nothing": None, "tilde": None,
+    }
+
+
+def test_timestamps_become_date_objects():
+    loaded = yaml_mini.safe_load("day: 2026-01-01\nstamp: 2026-01-01 07:17:03\n")
+    assert loaded["day"] == datetime.date(2026, 1, 1)
+    assert loaded["stamp"] == datetime.datetime(2026, 1, 1, 7, 17, 3)
+
+
+def test_duplicate_keys_last_value_wins_like_pyyaml():
+    doc = "model: a\nmodel: b\ndisplay:\n  tool_progress: all\n  tool_progress: off\n"
+    assert yaml_mini.safe_load(doc) == {"model": "b", "display": {"tool_progress": False}}
+
+
+def test_sequence_under_key_at_same_indent_is_pyyaml_output_style():
+    doc = "custom_providers:\n- name: one\n  api_key: PROXY_MANAGED\n- name: two\n"
+    assert yaml_mini.safe_load(doc) == {
+        "custom_providers": [{"name": "one", "api_key": "PROXY_MANAGED"}, {"name": "two"}]
+    }
+    assert yaml_mini.safe_load(yaml_mini.safe_dump({"toolsets": ["web", "terminal"]},
+                                                   sort_keys=False)) == {"toolsets": ["web", "terminal"]}
+
+
+def test_block_scalars_literal_folded_and_chomping():
+    assert yaml_mini.safe_load("v: |\n  a\n  b\n") == {"v": "a\nb\n"}
+    assert yaml_mini.safe_load("v: |-\n  a\n  b\n") == {"v": "a\nb"}
+    assert yaml_mini.safe_load("v: |+\n  a\n\n") == {"v": "a\n\n"}
+    assert yaml_mini.safe_load("v: >\n  a\n  b\n") == {"v": "a b\n"}
+    assert yaml_mini.safe_load("v: >\n  a\n\n  b\n") == {"v": "a\nb\n"}
+    assert yaml_mini.safe_load("v: |\n  a\nnext: 1\n") == {"v": "a\n", "next": 1}
+
+
+def test_long_text_values_round_trip_as_block_literals():
+    cfg = {"system_prompt": "line one\nline two\n", "tail": "no newline"}
+    text = yaml_mini.safe_dump(cfg, sort_keys=False)
+    assert "system_prompt: |\n  line one\n  line two\n" in text
+    assert "tail: no newline" in text
+    assert yaml_mini.safe_load(text) == cfg
+
+
+def test_quoted_scalar_with_trailing_comment():
+    assert yaml_mini.safe_load('cron: "17 7 * * *"  # nightly, 07:17 UTC\n') == {"cron": "17 7 * * *"}
+    assert yaml_mini.safe_load("cron: 'every day'   # note\n") == {"cron": "every day"}
+
+
+def test_plain_scalar_folds_over_many_continuation_lines():
+    doc = ("name: x\ndescription: one\n  two\n  three\n  four: not-a-key? no\nmaintainer: y\n")
+    loaded = yaml_mini.safe_load("description: one\n  two\n  three\nmaintainer: y\n")
+    assert loaded == {"description": "one two three", "maintainer": "y"}
+    # a continuation line that itself looks like a key ends the fold (PyYAML errors;
+    # we stop the fold and let the mapping layer report the indentation problem)
+    assert doc.count("description") == 1
+

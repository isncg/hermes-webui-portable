+def test_dump_sorts_by_default_and_keeps_order_when_asked():
+    data = {"b": 1, "a": {"z": 0, "y": 1}}
+    assert yaml_mini.safe_dump(data).splitlines()[0] == "a:"
+    assert yaml_mini.safe_dump(data, sort_keys=False).splitlines()[0] == "b: 1"

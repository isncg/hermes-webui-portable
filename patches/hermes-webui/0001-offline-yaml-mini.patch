+def test_rejects_tab_indentation_and_unbalanced_flow():
+    with pytest.raises(yaml_mini.MiniYAMLError):
+        yaml_mini.safe_load("a:\n\tb: 1\n")
+    with pytest.raises(yaml_mini.MiniYAMLError):
+        yaml_mini.safe_load("a: [1, 2\n")

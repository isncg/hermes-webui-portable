+def test_representer_rejects_unsupported_types():
+    with pytest.raises(yaml_mini.RepresenterError):
+        yaml_mini.safe_dump({"x": {1, 2}})
+    with pytest.raises(yaml_mini.RepresenterError):
+        yaml_mini.safe_dump({"x": b"bytes"})

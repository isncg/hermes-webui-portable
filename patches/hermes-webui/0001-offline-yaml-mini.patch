+def test_dump_quotes_yaml11_ambiguous_strings():
+    words = {"tool_progress": "off", "reasoning": "no", "mode": "on", "flag": "yes", "n": "n"}
+    text = yaml_mini.safe_dump(words, sort_keys=False)
+    assert yaml_mini.safe_load(text) == words
+    for value in ("off", "no", "on", "yes"):
+        assert ("'%s'" % value) in text
+    # bare y/n stay plain, exactly like PyYAML's YAML 1.1 table
+    assert "n: n" in text

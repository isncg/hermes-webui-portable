diff --git a/tests/test_clarify_choice_display_row.py b/tests/test_clarify_choice_display_row.py
new file mode 100644
index 000000000..b43f9757d
--- /dev/null
+++ b/tests/test_clarify_choice_display_row.py
@@ -0,0 +1,184 @@
+"""Clarify answers as visible user rows in the WebUI transcript.
+
+Covers the projection helper (tool result JSON -> display-only user row), the
+SSE/GET display boundaries that must inject it, and the guarantees that keep the
+persisted transcript and model-facing context free of synthetic rows.
+"""
+
+import json
+import os
+import sys
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+if str(REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(REPO_ROOT))
+os.environ.setdefault(
+    "HERMES_WEBUI_DEFAULT_WORKSPACE",
+    str(REPO_ROOT.parent / "workspace"),
+)
+
+from api.models import (  # noqa: E402
+    _clarify_tool_response_answers,
+    inject_clarify_response_display_rows,
+)
+
+SINGLE_RESULT = json.dumps(
+    {
+        "question": "Which environment?",
+        "choices_offered": ["staging", "prod"],
+        "user_response": "staging",
+    },
+    ensure_ascii=False,
+)
+
+BATCH_RESULT = json.dumps(
+    {
+        "responses": [
+            {"question": "Q1", "choices_offered": ["a", "b"], "user_response": "a"},
+            {"question": "Q2", "choices_offered": ["c", "d"], "user_response": ["c", "d"]},
+        ]
+    },
+    ensure_ascii=False,
+)
+
+
+def _tool(content, name="clarify", **extra):
+    message = {"role": "tool", "name": name, "content": content}
+    message.update(extra)
+    return message
+
+
+def test_single_response_row_lands_after_tool_result():
+    tool = _tool(SINGLE_RESULT, timestamp=1700000000)
+    rows = inject_clarify_response_display_rows([tool])
+    assert len(rows) == 2
+    assert rows[0] is tool
+    assert rows[1]["role"] == "user"
+    assert rows[1]["content"] == "staging"
+    assert rows[1]["_clarify_response"] is True
+    assert rows[1]["timestamp"] == 1700000000
+
+
+def test_batch_responses_project_in_order_and_join_multi_select():
+    rows = inject_clarify_response_display_rows([_tool(BATCH_RESULT)])
+    assert [row.get("content") for row in rows[1:]] == ["a", "c, d"]
+    assert all(row.get("_clarify_response") is True for row in rows[1:])
+
+
+def test_structured_content_parts_are_parsed():
+    tool = _tool([{"type": "text", "text": SINGLE_RESULT}])
+    assert _clarify_tool_response_answers(tool) == ["staging"]
+
+
+def test_blank_or_missing_answer_projects_nothing():
+    assert inject_clarify_response_display_rows(
+        [_tool(json.dumps({"question": "q", "user_response": ""}))]
+    ) == [_tool(json.dumps({"question": "q", "user_response": ""}))]
+    assert _clarify_tool_response_answers(_tool(json.dumps({"question": "q"}))) == []
+    assert _clarify_tool_response_answers(_tool(json.dumps({"responses": []}))) == []
+
+
+def test_malformed_and_non_clarify_tools_project_nothing():
+    malformed = _tool("{not json")
+    assert _clarify_tool_response_answers(malformed) == []
+    other = _tool(SINGLE_RESULT, name="bash")
+    assert _clarify_tool_response_answers(other) == []
+    assert inject_clarify_response_display_rows([malformed, other]) == [malformed, other]
+
+
+def test_projection_is_idempotent():
+    once = inject_clarify_response_display_rows([_tool(SINGLE_RESULT)])
+    twice = inject_clarify_response_display_rows(once)
+    assert twice == once
+    assert sum(1 for row in twice if row.get("_clarify_response")) == 1
+
+
+def test_projection_keeps_surrounding_turns_in_order():
+    rows = [
+        {"role": "user", "content": "deploy please"},
+        {"role": "assistant", "content": "Which environment?"},
+        _tool(SINGLE_RESULT),
+        {"role": "assistant", "content": "Deploying to staging."},
+    ]
+    projected = inject_clarify_response_display_rows(rows)
+    assert [row.get("role") for row in projected] == [
+        "user",
+        "assistant",
+        "tool",
+        "user",
+        "assistant",
+    ]
+    assert projected[3]["content"] == "staging"
+
+
+def test_merge_helper_does_not_persist_synthetic_rows():
+    from api.streaming import _merge_display_messages_after_agent_result
+
+    previous = [
+        {"role": "user", "content": "deploy please"},
+        {"role": "assistant", "content": "Which environment?"},
+        _tool(SINGLE_RESULT),
+    ]
+    merged = _merge_display_messages_after_agent_result(previous, previous, [], "deploy please")
+    assert not any(row.get("_clarify_response") for row in merged)
+
+
+def test_api_sanitizer_drops_display_row_but_keeps_tool_result():
+    from api.streaming import _sanitize_messages_for_api
+
+    tool = _tool(SINGLE_RESULT)
+    messages = [
+        {"role": "user", "content": "deploy please"},
+        {"role": "assistant", "content": "Which environment?"},
+        tool,
+        {"role": "user", "content": "staging", "_clarify_response": True},
+    ]
+    sanitized = _sanitize_messages_for_api(messages)
+    assert not any(row.get("_clarify_response") for row in sanitized)
+    assert any(row.get("role") == "tool" for row in sanitized)
+
+
+def test_session_payload_injects_display_row_without_touching_session_messages():
+    from api.streaming import _session_payload_with_full_messages
+
+    class _FakeSession:
+        session_id = "clarify-display-test"
+
+        def __init__(self):
+            self.tool_calls = []
+            self.truncation_watermark = None
+            self.truncation_boundary = None
+            self.messages = [
+                {"role": "user", "content": "deploy please"},
+                {"role": "assistant", "content": "Which environment?"},
+                _tool(SINGLE_RESULT),
+                {"role": "assistant", "content": "Deploying to staging."},
+            ]
+
+        def compact(self):
+            return {"session_id": self.session_id}
+
+    session = _FakeSession()
+    payload = _session_payload_with_full_messages(session)
+    payload_messages = payload["messages"]
+    assert any(row.get("_clarify_response") for row in payload_messages)
+    assert payload["message_count"] == len(payload_messages)
+    assert not any(row.get("_clarify_response") for row in session.messages)
+
+
+def test_display_boundaries_call_the_projection():
+    routes_src = (REPO_ROOT / "api" / "routes.py").read_text(encoding="utf-8")
+    assert "_all_msgs = inject_clarify_response_display_rows(_all_msgs)" in routes_src
+    assert "source_messages = inject_clarify_response_display_rows(source_messages)" in routes_src
+    streaming_src = (REPO_ROOT / "api" / "streaming.py").read_text(encoding="utf-8")
+    assert "visible_messages = inject_clarify_response_display_rows(" in streaming_src
+
+
+def test_client_echoes_choice_after_live_turn_blocks():
+    messages_src = (REPO_ROOT / "static" / "messages.js").read_text(encoding="utf-8")
+    respond_idx = messages_src.index("async function respondClarify")
+    respond_body = messages_src[respond_idx: respond_idx + 3000]
+    assert "S.messages.push" not in respond_body
+    assert "_appendClarifyChoiceEcho(value)" in respond_body
+    assert "blocks.appendChild(row)" in messages_src

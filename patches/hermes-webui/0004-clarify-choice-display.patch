+def _clarify_tool_response_answers(message):
+    """Return the user answer(s) embedded in a persisted clarify tool result.
+
+    The clarify tool returns a JSON payload such as
+    ``{"question": "...", "choices_offered": ["A", "B"], "user_response": "A"}``
+    (or ``{"responses": [...]}`` for a batch). The WebUI keeps tool rows in the
+    transcript for model replay but never renders them, so without a projected
+    user row the chosen option is lost from the visible chat and from reloads.
+    """
+    if not isinstance(message, dict) or message.get("role") != "tool":
+        return []
+    tool_name = str(message.get("name") or message.get("tool_name") or "").strip().lower()
+    if tool_name and tool_name != "clarify":
+        return []
+    content = message.get("content")
+    raw = ""
+    if isinstance(content, str):
+        raw = content.strip()
+    elif isinstance(content, list):
+        parts = []
+        for part in content:
+            if isinstance(part, str):
+                parts.append(part)
+            elif isinstance(part, dict):
+                text = part.get("text")
+                if not isinstance(text, str):
+                    text = part.get("content")
+                if isinstance(text, str):
+                    parts.append(text)
+        raw = "".join(parts).strip()
+    elif isinstance(content, dict):
+        raw = json.dumps(content, ensure_ascii=False)
+    if not raw:
+        return []
+    try:
+        payload = json.loads(raw)
+    except (TypeError, ValueError):
+        return []
+    entries = []
+    if isinstance(payload, dict):
+        responses = payload.get("responses")
+        if isinstance(responses, list):
+            entries = [entry for entry in responses if isinstance(entry, dict)]
+        elif "user_response" in payload:
+            entries = [payload]
+    answers = []
+    for entry in entries:
+        value = entry.get("user_response")
+        if isinstance(value, list):
+            value = ", ".join(str(item).strip() for item in value if str(item).strip())
+        answer = str(value or "").strip()
+        if answer:
+            answers.append(answer)
+    return answers
+
+
+def inject_clarify_response_display_rows(messages):
+    """Project clarify tool answers as user rows in the visible transcript.
+
+    A WebUI-only synthetic row is inserted immediately after each clarify tool
+    result so the chosen option appears at the point it was made and survives a
+    reload. The row is display-only: model-facing sanitizers drop
+    ``_clarify_response`` rows because the clarify tool result already carries
+    the answer. Re-running the projection is idempotent.
+    """
+    rows = list(messages or [])
+    if not rows:
+        return rows
+    projected = []
+    for index, message in enumerate(rows):
+        projected.append(message)
+        answers = _clarify_tool_response_answers(message)
+        if not answers:
+            continue
+        # The live UI echoes one bubble per answered question (a batch is asked
+        # one card at a time), so one synthetic row per answer keeps reloads
+        # matching what the user saw.
+        following = []
+        cursor = index + 1
+        while cursor < len(rows):
+            candidate = rows[cursor]
+            if (
+                isinstance(candidate, dict)
+                and candidate.get("role") == "user"
+                and candidate.get("_clarify_response") is True
+            ):
+                following.append(str(candidate.get("content") or "").strip())
+                cursor += 1
+                continue
+            break
+        if following == answers:
+            continue
+        pending = answers[len(following):] if following and answers[:len(following)] == following else answers
+        timestamp = message.get("timestamp", message.get("_ts"))
+        for answer in pending:
+            row = {
+                "role": "user",
+                "content": answer,
+                "_clarify_response": True,
+            }
+            if isinstance(timestamp, (int, float)) and not isinstance(timestamp, bool):
+                row["timestamp"] = timestamp
+            projected.append(row)
+    return projected
+
+

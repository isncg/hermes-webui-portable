+function _clarifyChoiceEchoBodyHtml(text) {
+  const value = String(text || '');
+  if (typeof _getCachedRender === 'function') {
+    try { return _getCachedRender(value, true); } catch (_err) {}
+  }
+  if (typeof esc === 'function') {
+    return esc(value).replace(/\n/g, '<br>');
+  }
+  const holder = document.createElement('div');
+  holder.textContent = value;
+  return holder.innerHTML.replace(/\n/g, '<br>');
+}
+
+function _appendClarifyChoiceEcho(text) {
+  const value = String(text || '').trim();
+  if (!value) return null;
+  const inner = $('msgInner');
+  if (!inner) return null;
+  const row = document.createElement('div');
+  row.className = 'msg-row clarify-choice-row';
+  row.dataset.role = 'user';
+  row.dataset.clarifyResponse = '1';
+  row.dataset.rawText = value;
+  row.innerHTML = `<div class="msg-body">${_clarifyChoiceEchoBodyHtml(value)}</div>`;
+  // Place the echo at the END of the live turn's block stack so later
+  // post-clarify assistant segments append BELOW it. Rendering it through
+  // S.messages + renderMessages() put the row before the preserved live turn,
+  // i.e. above the model text that preceded the question.
+  const turn = $('liveAssistantTurn');
+  const blocks = (turn && typeof _assistantTurnBlocks === 'function')
+    ? _assistantTurnBlocks(turn)
+    : null;
+  if (blocks) blocks.appendChild(row);
+  else inner.appendChild(row);
+  try {
+    const messagesEl = $('messages');
+    const nearBottom = !messagesEl
+      || (messagesEl.scrollHeight - messagesEl.scrollTop - messagesEl.clientHeight) <= 120;
+    if (nearBottom && typeof scrollToBottom === 'function') scrollToBottom();
+  } catch (_err) {}
+  return row;
+}

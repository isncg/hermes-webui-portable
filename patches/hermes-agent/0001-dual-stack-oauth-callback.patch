+class _LoopbackServerGroup:
+    """Serve one handler on both IPv4 and IPv6 loopback sockets sharing a port."""
+
+    def __init__(self, servers: list[HTTPServer]) -> None:
+        self._servers = servers
+        self.server_address = servers[0].server_address
+
+    def serve_forever(self, poll_interval: float = 0.5) -> None:
+        for server in self._servers[1:]:
+            threading.Thread(
+                target=server.serve_forever,
+                kwargs={"poll_interval": poll_interval},
+                daemon=True,
+            ).start()
+        self._servers[0].serve_forever(poll_interval=poll_interval)
+
+    def shutdown(self) -> None:
+        for server in self._servers:
+            server.shutdown()
+
+    def server_close(self) -> None:
+        for server in self._servers:
+            server.server_close()
+
+
+def _localhost_resolves_to_ipv6() -> bool:
+    """Whether ``localhost`` may resolve to ::1 for the browser (true on Windows)."""
+    try:
+        infos = socket.getaddrinfo("localhost", None, type=socket.SOCK_STREAM)
+    except OSError:
+        return False
+    return any(info[0] == socket.AF_INET6 for info in infos)
+

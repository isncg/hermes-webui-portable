+def _windows_system_proxy() -> "tuple[Optional[str], Optional[frozenset[str]]]":
+    """(proxy_url, bypass_hosts) from the Windows per-user system proxy registry, or (None, None).
+
+    Returns (None, None) quickly when off Windows, when the system proxy is disabled, or when
+    anything unexpected happens (registry read included) — a system-proxy fallback must never
+    break env-configured operation. Never cached across ``ProxyEnable`` toggles for longer than
+    ``_WIN_PROXY_CACHE_TTL`` seconds so turning Clash on/off is picked up promptly.
+    """
+    global _WIN_PROXY_CACHE
+    import time as _time
+
+    if sys.platform != "win32":
+        return None, None
+    now = _time.monotonic()
+    if _WIN_PROXY_CACHE is not None:
+        stamped_at, cached_proxy, cached_bypass = _WIN_PROXY_CACHE
+        if now - stamped_at < _WIN_PROXY_CACHE_TTL:
+            return cached_proxy, cached_bypass
+
+    proxy: Optional[str] = None
+    bypass: Optional[frozenset[str]] = None
+    try:
+        import winreg
+
+        with winreg.OpenKey(
+            winreg.HKEY_CURRENT_USER,
+            r"Software\Microsoft\Windows\CurrentVersion\Internet Settings",
+        ) as key:
+            try:
+                enabled, _ = winreg.QueryValueEx(key, "ProxyEnable")
+            except OSError:
+                enabled = 0
+            if not enabled:
+                proxy, bypass = None, frozenset()
+            else:
+                server, _ = winreg.QueryValueEx(key, "ProxyServer")
+                raw_server = str(server or "").strip()
+                # 'host:port' means one proxy for every scheme; 'http=h:p;https=h2:p2' is
+                # scheme-split (WinINET dialect) — take the https entry first, then http.
+                if "=" in raw_server:
+                    by_scheme: dict[str, str] = {}
+                    for part in raw_server.split(";"):
+                        scheme, _, value = part.strip().partition("=")
+                        if scheme and value:
+                            by_scheme[scheme.strip().lower()] = value.strip()
+                    chosen = by_scheme.get("https") or by_scheme.get("http") or ""
+                else:
+                    chosen = raw_server
+                if chosen:
+                    proxy = normalize_proxy_url(
+                        chosen if "://" in chosen else f"http://{chosen}"
+                    )
+                try:
+                    override, _ = winreg.QueryValueEx(key, "ProxyOverride")
+                except OSError:
+                    override = ""
+                # WinINET uses '<local>' for plain-hostname (no dot) bypass; those can't be
+                # an LLM API host, so they only matter as extra NO_PROXY-style entries.
+                # WinINET also allows bare-IP-prefix wildcards ('10.*', '192.168.1.*') that
+                # no_proxy_entry_matches does not understand — rewrite those as CIDRs so
+                # the shared matcher gives them the WinINET meaning.
+                entries: list[str] = []
+                for part in str(override or "").split(";"):
+                    token = part.strip()
+                    lowered = token.lower()
+                    if not token or lowered == "<local>":
+                        continue
+                    if lowered.endswith(".*") or lowered == "*":
+                        base = lowered[:-2] if lowered.endswith(".*") else ""
+                        octet_parts = base.split(".") if base else []
+                        if not octet_parts or all(p.isdigit() and 0 <= int(p) <= 255 for p in octet_parts):
+                            # '*' alone is handled by no_proxy_entry_matches; '10.*' ==
+                            # 10.0.0.0/8, '192.168.*' == 192.168.0.0/16.
+                            cidr = f"{'.'.join(octet_parts + ['0'] * (4 - len(octet_parts)))}/{8 * len(octet_parts)}"
+                            if cidr == "0.0.0.0/0":
+                                entries.append("*")
+                            elif _cidr_is_valid(cidr):
+                                entries.append(cidr)
+                            continue
+                    entries.append(token)
+                bypass = frozenset(entry.lower() for entry in entries)
+    except Exception:
+        proxy, bypass = None, None
+    _WIN_PROXY_CACHE = (now, proxy, bypass)
+    return proxy, bypass
+

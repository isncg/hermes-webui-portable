# Copy to .env and uncomment only the settings you need.
# Existing process environment variables take precedence.

# HERMES_HOME=C:\Users\your-name\.hermes
# HERMES_WEBUI_STATE_DIR=C:\Users\your-name\.hermes\webui
# HERMES_WEBUI_HOST=127.0.0.1
# HERMES_WEBUI_PORT=8787
# HERMES_WEBUI_PASSWORD=change-me-before-binding-to-a-lan-address

# Optional gateway bridge. Leave commented for the in-process Agent installed
# by setup.cmd. Enable both lines to use an OpenAI-compatible local gateway.
# HERMES_WEBUI_CHAT_BACKEND=gateway
# HERMES_WEBUI_GATEWAY_BASE_URL=http://127.0.0.1:15722/v1
